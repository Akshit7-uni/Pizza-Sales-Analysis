#include <iostream>
#include <fstream>
#include <string>
#include <vector>
#include <unordered_map>
#include <unordered_set>
#include <algorithm>

#include <nlohmann/json.hpp>

using namespace std;
using json = nlohmann::json;

struct Product {
    string product_id;
    string name;
    string category_id;
    string region;
    double popularity_score;
};

class BrowseEngine {
private:
    unordered_map<string, vector<string>> children;
    unordered_set<string> categories;

    unordered_map<string, vector<Product>> productsByCategory;

public:

    // Build category hierarchy
    void loadCategories(const json& data) {

        for (const auto& category : data["categories"]) {

            string id = category["category_id"];

            categories.insert(id);

            // parent_id == null means top-level
            if (!category["parent_id"].is_null()) {

                string parent = category["parent_id"];

                children[parent].push_back(id);
            }
        }
    }

    // Load products
    void loadProducts(const string& filename) {

        ifstream file(filename);

        if (!file.is_open()) {
            throw runtime_error("Could not open products file");
        }

        string line;

        while (getline(file, line)) {

            if (line.empty())
                continue;

            json data = json::parse(line);

            Product product;

            product.product_id = data["product_id"];
            product.name = data["name"];
            product.category_id = data["category_id"];
            product.region = data["region"];
            product.popularity_score = data["popularity_score"];

            productsByCategory[product.category_id].push_back(
                move(product)
            );
        }
    }

    // DFS to collect category + all descendants
    void collectCategories(
        const string& categoryId,
        unordered_set<string>& included
    ) {

        if (included.count(categoryId))
            return;

        included.insert(categoryId);

        auto it = children.find(categoryId);

        if (it == children.end())
            return;

        for (const string& child : it->second) {

            collectCategories(child, included);
        }
    }

    json browse(
        const string& categoryId,
        const string& region,
        int maxResults
    ) {

        json result;

        result["matched_count"] = 0;
        result["products"] = json::array();

        // Category does not exist
        if (!categories.count(categoryId)) {
            return result;
        }

        // Step 1:
        // Collect requested category + descendants
        unordered_set<string> includedCategories;

        collectCategories(
            categoryId,
            includedCategories
        );

        // Step 2:
        // Filter products by category + region
        vector<Product> eligible;

        for (const string& category : includedCategories) {

            auto it = productsByCategory.find(category);

            if (it == productsByCategory.end())
                continue;

            for (const Product& product : it->second) {

                // Exact, case-sensitive region match
                if (product.region == region) {

                    eligible.push_back(product);
                }
            }
        }

        // Number BEFORE max_results is applied
        result["matched_count"] = eligible.size();

        // Step 3:
        // Ranking
        sort(
            eligible.begin(),
            eligible.end(),
            [](const Product& a, const Product& b) {

                if (a.popularity_score != b.popularity_score) {

                    return a.popularity_score >
                           b.popularity_score;
                }

                // Tie breaker
                return a.product_id < b.product_id;
            }
        );

        // Return first maxResults
        int limit = min(
            maxResults,
            static_cast<int>(eligible.size())
        );

        for (int i = 0; i < limit; i++) {

            json product;

            product["product_id"] = eligible[i].product_id;
            product["name"] = eligible[i].name;

            result["products"].push_back(product);
        }

        return result;
    }
};

int main() {

    try {

        // --------------------------------------------------
        // 1. Load categories
        // --------------------------------------------------

        ifstream categoryFile(
            "data/categories.json"
        );

        if (!categoryFile.is_open()) {

            cerr << "Could not open categories.json\n";
            return 1;
        }

        json categoryData;

        categoryFile >> categoryData;


        // --------------------------------------------------
        // 2. Create browse engine
        // --------------------------------------------------

        BrowseEngine engine;

        engine.loadCategories(categoryData);

        engine.loadProducts(
            "data/products.json"
        );


        // --------------------------------------------------
        // 3. Read requests
        // --------------------------------------------------

        ifstream requestFile(
            "data/requests.jsonl"
        );

        if (!requestFile.is_open()) {

            cerr << "Could not open requests.json\n";
            return 1;
        }


        // --------------------------------------------------
        // 4. Output must be JSON array
        // --------------------------------------------------

        json output = json::array();

        string line;

        while (getline(requestFile, line)) {

            if (line.empty())
                continue;

            json request = json::parse(line);

            string queryId = request["query_id"];
            string categoryId = request["category_id"];
            string region = request["region"];

            int maxResults = request.value(
                "max_results",
                5
            );


            // --------------------------------------------------
            // Execute browse
            // --------------------------------------------------

            json browseResult = engine.browse(
                categoryId,
                region,
                maxResults
            );


            // --------------------------------------------------
            // Build output object
            // --------------------------------------------------

            json response;

            response["query_id"] = queryId;
            response["matched_count"] =
                browseResult["matched_count"];

            response["products"] =
                browseResult["products"];

            output.push_back(response);
        }


        // --------------------------------------------------
        // 5. Write output
        // --------------------------------------------------

        ofstream outputFile(
            "data/results.json"
        );

        if (!outputFile.is_open()) {

            cerr << "Could not create results.json\n";
            return 1;
        }

        outputFile << output.dump(4) << '\n';


        cout << "Results generated successfully.\n";
    }

    catch (const exception& e) {

        cerr << "Error: " << e.what() << '\n';

        return 1;
    }

    return 0;
}